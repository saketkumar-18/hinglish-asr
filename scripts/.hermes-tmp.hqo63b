"""Parallel chunked downloader for HF model files (range requests)."""
import os
import sys
import threading
import urllib.request
from concurrent.futures import ThreadPoolExecutor

URL = sys.argv[1]
DEST = sys.argv[2]
NCHUNKS = int(sys.argv[3]) if len(sys.argv) > 3 else 8

req = urllib.request.Request(URL, method="HEAD")
with urllib.request.urlopen(req, timeout=30) as r:
    total = int(r.headers["Content-Length"])
    accept_ranges = r.headers.get("Accept-Ranges", "")

print(f"total={total} accept_ranges={accept_ranges!r}")
if accept_ranges.lower() != "bytes":
    print("NO RANGE SUPPORT - falling back to single stream")
    urllib.request.urlretrieve(URL, DEST)
    print("done single")
    sys.exit(0)

os.makedirs(os.path.dirname(DEST) or ".", exist_ok=True)
chunk = (total + NCHUNKS - 1) // NCHUNKS
parts = []
lock = threading.Lock()
done_bytes = [0]


def fetch(i):
    start = i * chunk
    end = min(start + chunk, total) - 1
    part = DEST + f".part{i}"
    # resume support
    existing = os.path.getsize(part) if os.path.exists(part) else 0
    if existing == end - start + 1:
        with lock:
            done_bytes[0] += existing
        return
    s = start + existing
    req = urllib.request.Request(URL, headers={"Range": f"bytes={s}-{end}"})
    with urllib.request.urlopen(req, timeout=120) as r, open(part, "ab") as f:
        while True:
            b = r.read(1 << 16)
            if not b:
                break
            f.write(b)
            with lock:
                done_bytes[0] += len(b)


with ThreadPoolExecutor(max_workers=NCHUNKS) as ex:
    list(ex.map(fetch, range(NCHUNKS)))

with open(DEST, "wb") as out:
    for i in range(NCHUNKS):
        part = DEST + f".part{i}"
        with open(part, "rb") as f:
            out.write(f.read())
        os.remove(part)

print(f"assembled {DEST} size={os.path.getsize(DEST)} expected={total} ok={os.path.getsize(DEST)==total}")
